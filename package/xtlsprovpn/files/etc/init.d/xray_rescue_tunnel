#!/bin/sh /etc/rc.common
START=99
STOP=10
USE_PROCD=1
start_service() {
    [ -s /var/run/xtlspro-rescue/command.sh ] || return 1
    procd_open_instance
    procd_set_param command /usr/bin/xray-rescue-tunnel
    # The watch policy owns backoff; procd must not retry on its own.
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param term_timeout 5
    procd_close_instance
}
