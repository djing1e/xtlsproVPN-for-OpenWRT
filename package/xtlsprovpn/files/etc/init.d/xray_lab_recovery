#!/bin/sh /etc/rc.common
# Repair stored transactions and keep one-arm clients using their configured gateway.
START=98
STOP=16
start() {
    /usr/bin/xray-lab-subscription-journal recover || return 1
    [ -s /etc/forkop-xray/subscription.json ] || return 0
    /usr/bin/xray-lab-redirects up
}
stop() {
    /usr/bin/xray-lab-redirects down
}
