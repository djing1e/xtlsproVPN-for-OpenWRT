#!/bin/sh /etc/rc.common
START=98
STOP=16
USE_PROCD=1
start_service() {
    [ "$(uci -q get xray_lab_dns.main.enabled)" = 1 ] || return 0
    [ "$(uci -q get xray_lab_dns.main.ttl_enabled)" = 1 ] || return 0
    ttl=$(uci -q get xray_lab_dns.main.ttl) || return 1
    case "$ttl" in ''|*[!0-9]*) return 1 ;; esac
    [ "$ttl" -le 86400 ] || return 1
    procd_open_instance
    procd_set_param command /usr/bin/ucode /usr/share/xray/lab/dns_ttl.uc "$ttl" 10553 5300
    procd_set_param respawn 3600 3 3
    procd_set_param limits nofile=128
    procd_close_instance
}
