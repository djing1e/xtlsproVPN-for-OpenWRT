config general 'general'
    option transparent_proxy_enable '0'
    option xray_bin '/usr/libexec/forkop-xray/xray'
    option fx_dashboard '1'
    option fx_start_authorized '0'
    option fx_mode 'auto'
    option fx_probe_url 'https://cp.cloudflare.com/generate_204'
    option fx_probe_interval '60'
    option fx_watchdog_enabled '1'
    option fx_watch_interface 'wan'
    option fx_watch_delay '3000'
    option dnsmasq_integration_mode 'global'
