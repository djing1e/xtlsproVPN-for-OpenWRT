#!/usr/bin/ucode
let fs=require('fs');
if (ARGV[0]=='list') {
    print('{"status":{},"launch":{"action":"","version":"","sha256":""}}');exit(0);
}
if (ARGV[0]!='call') exit(1);
if (ARGV[1]=='status') {
    let p=fs.popen('/usr/bin/xray-lab-package status 2>/dev/null','r');
    let s=p?.read('all');let rc=p?.close();
    print(rc==0 && s?s:'{"error":"Не удалось прочитать статус обновления"}');exit(0);
}
let r;
try {r=json(fs.stdin.read(4097) || '');} catch(e) {}
if (ARGV[1]!='launch' || type(r)!='object' || index(['check','install'],r.action)<0) {
    print('{"error":"Недопустимое действие"}');exit(0);
}
let v=r.version || '',h=r.sha256 || '';
if (r.action=='check') {v='';h='';}
else if (type(v)!='string' || length(v)>=64 || !match(v,/^[0-9]+\.[0-9]+\.[0-9]+-r[0-9]+$/) ||
    type(h)!='string' || !match(h,/^[a-f0-9]{64}$/)) {
    print('{"error":"Проверьте релиз и выберите доступную версию"}');exit(0);
}
let p=fs.popen('/usr/bin/xray-lab-package launch '+r.action+" '"+v+"' '"+h+"' 2>/dev/null",'r');
let s=p?.read('all');let rc=p?.close();
// Print in the rpcd interpreter; a child stdout alone is not an RPC response.
print(rc==0 && s?s:'{"error":"Операция обновления не запущена"}');
