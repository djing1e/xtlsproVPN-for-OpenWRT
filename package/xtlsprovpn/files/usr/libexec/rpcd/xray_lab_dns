#!/usr/bin/ucode
import { load_options } from '/usr/share/xray/lab/dns_options.mjs';
let fs=require('fs');
let op=ARGV[0],method=ARGV[1],root='/var/run/xray-lab-control';
if(op=='list'){print('{"get":{},"launch":{"action":"","settings":""}}');exit(0);}
if(op!='call')exit(1);
if(method=='get') {
    let p=fs.popen('/usr/bin/xray-lab-dns status 2>/dev/null','r');
    if(!p){print('{"error":"Не удалось получить настройки DNS"}');exit(0);}
    let body=p.read('all');if(p.close()!=0)print('{"error":"Ошибка чтения настроек DNS"}');else print(body);exit(0);
}
if(method!='launch'){print('{"error":"Unknown method"}');exit(0);}
let p;
try{p=json(fs.stdin.read('all') || '{}');}catch(e){print('{"error":"Invalid request"}');exit(0);}
if(index(['test','apply','restore','route_test','route_apply'],p.action)<0 || type(p.settings)!='string' || length(p.settings)>65536){print('{"error":"Invalid action or settings"}');exit(0);}
try {if(type(json(p.settings))!='object')die('Invalid settings');}catch(e){print('{"error":"Настройки должны быть JSON-объектом"}');exit(0);}
if(p.action=='restore') {
    // Preserve source selection, outbound binding and QUIC policy.
    let options={};
    try {options=load_options() || {};} catch(e) {}
    options={...options,enabled:'1',protocol:'udp',provider:'custom',servers:['1.1.1.1','8.8.8.8'],
        bootstrap:['1.1.1.1','8.8.8.8'],strategy:'ipv4',via_proxy:'0',ttl_enabled:'0',ttl:'60'};
    p.settings=sprintf('%J',options);
    p.action='apply';
}
let id=trim(fs.readfile('/proc/sys/kernel/random/uuid') || '');
if(!match(id,/^[a-f0-9-]{36}$/)){print('{"error":"Не удалось создать операцию"}');exit(0);}
fs.mkdir(root,0700);
let path=root+'/dns-input-'+id+'.json';
if(!fs.writefile(path,p.settings)){print('{"error":"Не удалось подготовить настройки"}');exit(0);}
fs.chmod(path,0600);
let child=fs.popen('/usr/bin/xray-lab-dns launch '+p.action+' '+id+' 2>/dev/null','r');
if(!child){fs.unlink(path);print('{"error":"Ошибка запуска"}');exit(0);}
let body=child.read('all');if(child.close()!=0){fs.unlink(path);print('{"error":"Ошибка запуска DNS-операции"}');}else print(body || '{}');
