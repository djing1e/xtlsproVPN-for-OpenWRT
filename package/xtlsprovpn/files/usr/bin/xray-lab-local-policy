#!/bin/sh
# Keep marked client source validation out of TPROXY's local-default table.
# Own only priority 103 / protocol 242 / mark 251 / main-table rules.
set -eu
umask 077
RUN=${FX_POLICY_RUN:-/var/run/xray-lab-control}
mkdir -p "$RUN"
exec 7>"$RUN/local-policy.lock"
flock 7
work=$(mktemp -d "$RUN/local-policy.XXXXXX")
trap 'rm -rf "$work"' EXIT

valid_prefix() {
    printf '%s\n' "$1" | awk -F '[./]' '
        NF != 5 {exit 1}
        {for(i=1;i<=5;i++) if($i !~ /^[0-9]+$/) exit 1}
        {for(i=1;i<=4;i++) if($i>255) exit 1}
        $5<1 || $5>32 {exit 1}'
}

ip -4 -o rule show protocol 242 > "$work/current"
prefixes() {
    awk '$1=="103:" && /fwmark 0xfb(\/0xffffffff)? / && /lookup main([[:space:]]|$)/ {
        for(i=1;i<NF;i++) if($i=="to") print $(i+1)
    }' "$1" | sort -u
}
prefixes "$work/current" > "$work/owned"
ip -4 -o rule show > "$work/all"
prefixes "$work/all" > "$work/existing"
: > "$work/desired"
case "${1:-up}" in
up)
    if [ "$(uci -q get xray_core.general.transparent_proxy_enable || :)" = 1 ]; then
        devices=
        if [ "$(uci -q get xray_lab_dns.main.enabled || :)" = 1 ]; then
            devices=$(uci -q get xray_lab_dns.main.sources || :)
        fi
        [ -n "$devices" ] || devices=$(uci -q get xray_core.general.lab_iface || :)
        [ -n "$devices" ] || devices=br-lan
        for device in $devices; do
            case "$device" in ''|*[!A-Za-z0-9_.:-]*) exit 1;; esac
            ip -4 route show table main dev "$device" proto kernel scope link |
                awk '{print $1}' >> "$work/desired"
        done
    fi
    ;;
down) ;;
*) echo 'Usage: xray-lab-local-policy up|down' >&2; exit 2;;
esac
sort -u "$work/desired" > "$work/sorted"
# Validate every route before changing policy. No default or remote routes.
while IFS= read -r prefix; do valid_prefix "$prefix" || exit 1; done < "$work/sorted"
while IFS= read -r prefix; do
    grep -qxF "$prefix" "$work/existing" && continue
    ip -4 rule add pref 103 fwmark 0xfb/0xffffffff to "$prefix" lookup main protocol 242
done < "$work/sorted"
while IFS= read -r prefix; do
    valid_prefix "$prefix" || exit 1
    grep -qxF "$prefix" "$work/sorted" && continue
    ip -4 rule del pref 103 fwmark 0xfb/0xffffffff to "$prefix" lookup main protocol 242
done < "$work/owned"
