#!/bin/sh
set -eu
umask 077
RUN=/var/run/xtlspro-netbird
LIB=/usr/share/xray/lab/netbird.uc
mkdir -p "$RUN"
chmod 700 "$RUN"
mode=${1:-status}
action=${2:-}
case "$mode" in
status) exec ucode "$LIB" status ;;
launch)
    case "$action" in install|connect|disconnect) ;; *) exit 2 ;; esac
    exec 9>"$RUN/action.lock"
    if ! flock -n 9; then
        echo '{"error":"Операция NetBird уже выполняется"}'
        exit 0
    fi
    if ! ucode "$LIB" stage "$action"; then exit 0; fi
    (trap '' HUP; exec "$0" worker "$action") </dev/null >/dev/null 2>&1 &
    echo '{"ok":true}'
    ;;
worker)
    case "$action" in install|connect|disconnect) ;; *) exit 2 ;; esac
    exec ucode "$LIB" worker "$action"
    ;;
*) exit 2 ;;
esac
