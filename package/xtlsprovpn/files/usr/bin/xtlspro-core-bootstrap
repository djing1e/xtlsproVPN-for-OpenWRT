#!/bin/sh
set -eu
umask 077
version=${1:-26.7.28}
printf '%s\n' "$version" | grep -Eq '^[0-9]{1,3}\.[0-9]{1,2}\.[0-9]{1,2}$' || exit 2
[ "$(uname -m)" = aarch64 ] || { echo 'Первая сборка поддерживает ARM64.';exit 1; }
BIN=/usr/libexec/forkop-xray/xray
[ ! -e "$BIN" ] || { echo 'Ядро уже установлено. Используйте обновлятор в настройках.';exit 1; }
mkdir -p /var/run/xray-lab-control
exec 9>/var/run/xray-lab-control/action.lock
flock -n 9 || { echo 'Другая операция выполняется';exit 1; }
work=$(mktemp -d /tmp/xtlspro-core-bootstrap.XXXXXX)
trap 'rm -rf "$work"' EXIT
available=$(awk '/^MemAvailable:/ {print $2}' /proc/meminfo)
[ "${available:-0}" -ge 102400 ] || { echo 'Для распаковки нужно 100 МиБ доступной RAM';exit 1; }
url="https://github.com/XTLS/Xray-core/releases/download/v$version/Xray-linux-arm64-v8a.zip"
if [ "$#" = 3 ];then
    cp "$2" "$work/core.zip"
    cp "$3" "$work/core.zip.dgst"
elif [ "$#" -le 1 ];then
for file in core.zip core.zip.dgst;do
    suffix=;[ "$file" != core.zip.dgst ] || suffix=.dgst
    curl --fail --silent --show-error --location --max-redirs 3 --proto '=https' --proto-redir '=https' \
        --connect-timeout 10 --max-time 180 --max-filesize 33554432 "$url$suffix" -o "$work/$file"
done
else echo 'Usage: xtlspro-core-bootstrap [VERSION [ZIP DIGEST]]';exit 2;fi
expected=$(ucode /usr/share/xray/lab/core_update.uc checksum "$work/core.zip.dgst" | tr A-F a-f)
actual=$(sha256sum "$work/core.zip" | awk '{print $1}')
[ "$expected" = "$actual" ] || { echo 'Ошибка SHA-256';exit 1; }
size=$(unzip -l "$work/core.zip" xray | awk '$NF=="xray" {print $1}')
case "$size" in ''|*[!0-9]*)exit 1;;esac
[ "$size" -gt 0 ] && [ "$size" -le 67108864 ]
(ulimit -f 131072;unzip -p "$work/core.zip" xray > "$work/xray")
[ "$(wc -c < "$work/xray")" -eq "$size" ]
rm "$work/core.zip" "$work/core.zip.dgst"
chmod 700 "$work/xray"
[ "$("$work/xray" version | awk 'NR==1 {print $2}')" = "$version" ]
free=$(df -Pk /overlay | awk 'NR==2 {print $4}')
[ "$free" -ge "$(( (size+1023)/1024+4096 ))" ] || { echo 'Недостаточно свободного места';exit 1; }
[ -d /usr/libexec/forkop-xray ] || mkdir -m 755 /usr/libexec/forkop-xray
cp "$work/xray" "$BIN.new"
chmod 755 "$BIN.new"
mv "$BIN.new" "$BIN"
rm -f /var/run/xray-lab-control/core-version
printf 'Ядро %s установлено. Прокси остановлен; добавьте подписку в настройках.\n' "$version"
