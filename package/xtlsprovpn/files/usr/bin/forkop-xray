#!/bin/sh
set -eu
umask 077
LIB=${FX_LIB:-/usr/lib/forkop-xray}
STATE=${FX_STATE_DIR:-/etc/forkop-xray}
RUN=${FX_RUN_DIR:-/var/run/forkop-xray}
mkdir -p "$STATE" "$RUN"
chmod 700 "$STATE" "$RUN"
case "${1:-status}" in
    status|nodes) exec ucode -L "$LIB" "$LIB/main.uc" "$@" ;;
    update|update-due|import|policy-import|select|prepare|rollback|routing-set|routing-clear|routing-tick|routing-refresh-due|routing-check|routing-urltest|routing-lists) ;;
    *) echo 'Usage: forkop-xray status|nodes|update|import FILE|policy-import TEMPLATE.json|select ID|prepare|rollback|routing-set PROFILE.json|routing-clear|routing-tick|routing-refresh-due|routing-check PROFILE.json|routing-lists PROFILE.json|routing-urltest' >&2; exit 2 ;;
esac
# flock releases automatically on termination; serialize cron/UI/manual operations.
exec 9>"$RUN/lock"
flock -n 9 || { echo 'Forkop-Xray: another operation is running' >&2; exit 1; }
before=$(sha256sum "$STATE/subscription.json" "$STATE/rulesets.json" 2>/dev/null || true)
result=0
ucode -L "$LIB" "$LIB/main.uc" "$@" || result=$?
after=$(sha256sum "$STATE/subscription.json" "$STATE/rulesets.json" 2>/dev/null || true)
flock -u 9
if [ "$result" -eq 0 ] && [ "${FX_NO_RELOAD:-0}" != 1 ] && [ "$before" != "$after" ]; then
    case "$1" in
        update|update-due|import|policy-import|select|rollback|routing-set|routing-clear|routing-refresh-due|routing-lists)
            if /etc/init.d/forkop-xray running 2>/dev/null; then
                /etc/init.d/forkop-xray reload
            fi ;;
    esac
fi
exit "$result"
