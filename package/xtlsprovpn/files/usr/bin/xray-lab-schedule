#!/bin/sh
set -eu
umask 077

# Only validated numeric arguments reach cron.
[ "$#" = 5 ] || exit 1
case "$1:$3" in 0:0|0:1|1:0|1:1) ;; *) exit 1 ;; esac
case "$2" in 1|3|6|12|24) ;; *) exit 1 ;; esac
case "$4" in 1|3|6|12|24) ;; *) exit 1 ;; esac
case "$5" in ''|*[!0-9]*) exit 1 ;; esac
[ "${#5}" -le 2 ] && [ "$5" -le 59 ] || exit 1

mkdir -p /var/run/xray-lab-control
exec 9>/var/run/xray-lab-control/schedule.lock
if ! flock -n 9; then
    echo '{"error":"Расписание уже сохраняется. Повторите позже."}'
    exit 0
fi

WORK=$(mktemp -d /tmp/xray-schedule-save.XXXXXX)
BACKUP=
CHANGED=0
CONFIG=/etc/config/xray_lab_schedule

finish() {
    rc=$?
    trap - EXIT HUP INT TERM
    if [ "$rc" != 0 ]; then
        if [ "$CHANGED" = 1 ]; then
            crontab "$WORK/previous.cron" >/dev/null 2>&1 || :
            if [ -f "$WORK/previous.config" ]; then
                cp -p "$WORK/previous.config" "$CONFIG"
            else
                rm -f "$CONFIG"
            fi
        fi
        echo '{"error":"Не удалось сохранить расписание. Проверьте cron и свободное место."}'
    fi
    rm -rf "$WORK"
    exit "$rc"
}
trap finish EXIT
trap 'exit 1' HUP INT TERM

if ! crontab -l > "$WORK/previous.cron" 2>/dev/null; then
    # Do not overwrite a readable existing schedule after a read error.
    [ ! -s /etc/crontabs/root ] || exit 1
    : > "$WORK/previous.cron"
fi

[ ! -f "$CONFIG" ] || cp -p "$CONFIG" "$WORK/previous.config"

awk '
    /# xray-lab-subscription-sync([[:space:]]|$)/ { next }
    /# xray-lab-routing-update([[:space:]]|$)/ { next }
    { print }
' "$WORK/previous.cron" > "$WORK/new.cron"

if [ "$1" = 1 ]; then
    printf '\n0 */%s * * * (umask 077; /usr/bin/xray-lab sync > /tmp/xray-lab-sync.log 2>&1) # xray-lab-subscription-sync\n' \
        "$2" >> "$WORK/new.cron"
fi

if [ "$3" = 1 ]; then
    printf '\n%s */%s * * * (umask 077; /usr/bin/xray-lab-routing update > /tmp/xray-lab-routing-update.log 2>&1) # xray-lab-routing-update\n' \
        "$5" "$4" >> "$WORK/new.cron"
fi

cat > "$WORK/new.config" <<EOF
config schedule 'main'
    option subscription_enabled '$1'
    option subscription_hours '$2'
    option routing_enabled '$3'
    option routing_hours '$4'
    option routing_minute '$5'
EOF

BACKUP=$(mktemp -d /etc/xray-schedule-settings-backup.XXXXXX)
cp "$WORK/previous.cron" "$BACKUP/root.crontab"
[ ! -f "$WORK/previous.config" ] ||
    cp -p "$WORK/previous.config" "$BACKUP/xray_lab_schedule"

CHANGED=1
crontab "$WORK/new.cron"
cp "$WORK/new.config" "$CONFIG.schedule-new"
chmod 600 "$CONFIG.schedule-new"
mv "$CONFIG.schedule-new" "$CONFIG"

/etc/init.d/cron enable >/dev/null 2>&1
/etc/init.d/cron start >/dev/null 2>&1

CHANGED=0
echo '{"ok":true,"message":"Расписание сохранено. Xray не перезапускался."}'
