#!/bin/sh
umask 077
RUN=/var/run/xtlspro-netbird
mkdir -p "$RUN"
chmod 700 "$RUN"
while :; do
    [ "$(uci -q get xray_lab_netbird.main.enabled)" = 1 ] || exit 0
    (
        # Same lock order as package operations. No overlap with connect/update,
        # subscription application or firewall recovery.
        exec 9>"$RUN/action.lock"
        flock -n 9 || exit 0
        mkdir -p /var/run/xray-lab-control
        exec 8>/var/run/xray-lab-control/action.lock
        flock -n 8 || exit 0
        timeout -k 2 30 /usr/bin/xray-dns-bind || logger -t xray-netbird-guard 'DNS listener isolation failed'
        timeout -k 2 55 ucode /usr/share/xray/lab/netbird_guard.uc || :
    )
    sleep 30
done
