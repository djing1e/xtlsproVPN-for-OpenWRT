#!/bin/sh
set -eu
umask 077
RUN=/var/run/xray-lab-control
mkdir -p "$RUN"

jobset() {
    ucode - "$1" "$2" "$3" "$4" <<'UC'
let fs=require('fs');
let path='/var/run/xray-lab-control/core-ui-job.json';
let old={};
try { old=json(fs.readfile(path) || '{}'); } catch(e) {}
let value={
    state:ARGV[0],action:ARGV[1],pid:int(ARGV[2]),
    code:int(ARGV[3]),updated:time(),
    started:ARGV[0]=='pending'?time():old.started || time()
};
if (!fs.writefile(path+'.new',sprintf('%J\n',value)))
    die('Cannot write core job');
fs.chmod(path+'.new',0600);
if (!fs.rename(path+'.new',path))
    die('Cannot commit core job');
UC
}

mode=${1:-}
action=${2:-}
version=${3:-}

case "$action" in
    list|rollback|purge-backup) version= ;;
    test|install)
        case "$version" in ''|*[!0-9.]*) exit 2 ;; esac
        printf '%s\n' "$version" |
            grep -Eq '^[0-9]{1,3}\.[0-9]{1,2}\.[0-9]{1,2}$' || exit 2
        ;;
    *) exit 2 ;;
esac

case "$mode" in
launch)
    exec 6>"$RUN/core-ui.lock"
    if ! flock -n 6; then
        echo '{"error":"Операция с ядром уже выполняется"}'
        exit 0
    fi
    jobset pending "$action" 0 0
    (trap '' HUP; exec "$0" worker "$action" "$version") \
        </dev/null >"$RUN/core-ui-worker.log" 2>&1 &
    echo '{"ok":true}'
    ;;
worker)
    jobset running "$action" "$$" 0
    if /usr/bin/xray-lab-core "$action" "$version" \
        >"$RUN/core-ui.log" 2>&1 6>&-
    then
        jobset done "$action" "$$" 0
    else
        rc=$?
        jobset failed "$action" "$$" "$rc"
    fi
    tail -n 100 "$RUN/core-ui.log" > "$RUN/core-ui.tail"
    mv "$RUN/core-ui.tail" "$RUN/core-ui.log"
    ;;
*) exit 2 ;;
esac
